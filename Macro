-- --- FIXED TRACKPAD DRAG MOVEMENT MOTOR ---
local trackingInput = nil
local lastTrackpadX = 0
local lastTrackpadY = 0

TouchSurface.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch and not trackingInput then
        trackingInput = input
        lastTrackpadX = input.Position.X
        lastTrackpadY = input.Position.Y
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == trackingInput then
        local deltaX = input.Position.X - lastTrackpadX
        local deltaY = input.Position.Y - lastTrackpadY
        cursorX = cursorX + (deltaX * sensitivity)
        cursorY = cursorY + (deltaY * sensitivity)
        updateCrosshairPosition()
        lastTrackpadX = input.Position.X
        lastTrackpadY = input.Position.Y
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == trackingInput then
        trackingInput = nil
    end
end)

