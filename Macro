-- --- AUTOFIRE LOOP HANDLING ---
local holding = false
local toggled = false
local dragInput
local SIMULATED_FINGER_ID = 9
local fastFireConnection

local function stopAutoFire()
    if fastFireConnection then
        fastFireConnection:Disconnect()
        fastFireConnection = nil
    end
end

local function runAutoFire()
    stopAutoFire()
    fastFireConnection = RunService.Heartbeat:Connect(function()
        if not holding and not toggled then 
            stopAutoFire()
            return 
        end
        VIM:SendTouchEvent(SIMULATED_FINGER_ID, 0, cursorX, cursorY)
        VIM:SendTouchEvent(SIMULATED_FINGER_ID, 2, cursorX, cursorY)
    end)
end

ToggleButton.Activated:Connect(function()
    toggled = not toggled
    if toggled then
        ToggleStroke.Color = Color3.fromRGB(0, 255, 150)
        ToggleButton.TextColor3 = Color3.fromRGB(0, 255, 150)
        ch_h.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        ch_v.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        ch_dot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        runAutoFire()
    else
        ToggleStroke.Color = Color3.fromRGB(255, 255, 255)
        ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        if not holding then
            stopAutoFire()
            VIM:SendTouchEvent(SIMULATED_FINGER_ID, 2, cursorX, cursorY)
            ch_h.BackgroundColor3 = Color3.fromRGB(0, 255, 136)
            ch_v.BackgroundColor3 = Color3.fromRGB(0, 255, 136)
            ch_dot.BackgroundColor3 = Color3.fromRGB(0, 255, 136)
        end
    end
end)

